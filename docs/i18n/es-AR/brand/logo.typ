#set page(
  width: 500pt,
  height: 500pt,
  margin: 0pt,
  fill: none,
)

#set text(
  size: 600pt,
  weight: "bold",
  fill: white,
  top-edge: "bounds",
  bottom-edge: "bounds",
)


#place(
  top + left,
  text(
    font: "Amster",
    style: "italic",
    weight: 800,
    fill: rgb(35, 157, 173),
    "t",
  ),
)

#place(
  bottom + right,
  text(
    font: "Reforma 2018",
    weight: "bold",
    style: "italic",
    bottom-edge: "baseline",
    fill: rgb("#F6B40E"),
    "ñ",
  ),
)
